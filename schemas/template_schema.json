{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plantilla_base_ADG",
  "description": "Etiquetas Mustache de la plantilla Google Slides ADG Media Group. Ver docs/reference/plantilla_estructura.md",
  "type": "object",
  "properties": {
    "titulo_presentacion": {
      "type": "string",
      "description": "Título principal (portada)"
    },
    "subtitulo_presentacion": {
      "type": "string",
      "description": "Subtítulo de la presentación"
    },
    "contenido_01": {
      "type": "string",
      "description": "Índice apartado 01 (formato: Título: Subtítulo)"
    },
    "contenido_02": { "type": "string" },
    "contenido_03": { "type": "string" },
    "contenido_04": { "type": "string" },
    "contenido_05": { "type": "string" },
    "contenido_06": { "type": "string" },
    "informe_titulo": {
      "type": "string",
      "description": "Ej. Informe mensual - Madrid"
    },
    "informe_periodo": {
      "type": "string",
      "description": "Ej. Marzo 2026"
    },
    "separador_titulo": {
      "type": "string",
      "description": "Título de diapositiva separador"
    },
    "separador_subtitulo": {
      "type": "string",
      "description": "Subtítulo del separador"
    },
    "contacto": {
      "type": "string",
      "description": "Datos de contacto en diapositiva de cierre"
    },
    "cliente": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "filial": {
      "type": "string",
      "enum": ["ad_gravity", "la_naranja_mecanica", "neural_one", "adg"],
      "description": "Filial ADG para decisiones dinámicas de marca"
    },
    "inversion_essential": {
      "type": "string",
      "description": "Inversión paquete Essential (ej. 15k)"
    },
    "inversion_advanced": {
      "type": "string",
      "description": "Inversión paquete Advanced (ej. 20k)"
    },
    "inversion_elite": {
      "type": "string",
      "description": "Inversión paquete Elite (ej. 30k)"
    },
    "cpm_objetivo_essential": { "type": "string" },
    "cpm_objetivo_advanced": { "type": "string" },
    "cpm_objetivo_elite": { "type": "string" },
    "alcance_essential": { "type": "string" },
    "alcance_advanced": { "type": "string" },
    "alcance_elite": { "type": "string" },
    "impresiones_essential": { "type": "string" },
    "impresiones_advanced": { "type": "string" },
    "impresiones_elite": { "type": "string" },
    "tabla_inversion_markdown": {
      "type": "string",
      "description": "Tabla de inversión en Markdown"
    },
    "resumen_ejecutivo": { "type": "string" },
    "notas_adicionales": { "type": "string" }
  },
  "required": [
    "titulo_presentacion",
    "subtitulo_presentacion",
    "cliente"
  ],
  "additionalProperties": false
}
