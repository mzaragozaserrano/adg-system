# URL pública del backend FastAPI (sin barra final).
# Ejemplo: https://adg-system-api.onrender.com
VITE_API_URL=https://tu-api.ejemplo.com

# Google Picker (se ejecuta en el navegador; la key debe permitir el dominio de Vercel)
# Mismos valores que GOOGLE_API_KEY y GOOGLE_APP_ID del backend / GCP.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
